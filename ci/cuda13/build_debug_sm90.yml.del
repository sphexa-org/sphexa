include:
  - local: 'ci/common.yml'

variables:
  # GIT_SUBMODULE_STRATEGY: "recursive"

sph-build-cuda12-sm90-debug:
  stage: sphexa_build
  image: prgenv-gnu/26.3:v1
  extends: [.uenv-runner-daint-gh200]
  variables:
    SLURM_TIMELIMIT: '01:00:00'
    PERSIST_IMAGE_NAME: ${CSCS_REGISTRY_PATH}/sphexa_cuda12_debug:${CI_COMMIT_SHORT_SHA}
    WITH_UENV_VIEW: 'spack'  # this is not 'default' view
    # SLURM_PARTITION: 'debug'
    SLURM_JOB_NUM_NODES: 1
  before_script:
    # NOTE: error 'script config should be a string or a nested array of
    # strings up to 10 levels deep' -> add '' around the command to execute
    - echo "CI_PROJECT_URL=$CI_PROJECT_URL"
    - echo "CI_COMMIT_SHORT_SHA=$CI_COMMIT_SHORT_SHA"
    - echo "CI_COMMIT_SHA=$CI_COMMIT_SHA"
    - 'uenv_dir=`echo $UENV_VIEW |cut -d: -f1`'
    - 'uenv_view=`echo $UENV_VIEW |cut -d: -f3`'
    - echo "uenv_dir=$uenv_dir uenv_view=$uenv_view / UENV_VIEW=$UENV_VIEW"
    # setup spack
    - git clone https://github.com/eth-cscs/uenv-spack.git uenv-spack.git
    - 'export PATH=$PWD/uenv-spack.git:$PATH'
    - 'export SPACK_SYSTEM_CONFIG_PATH=$UENV_SPACK_CONFIG_PATH'
    - echo "SPACK_SYSTEM_CONFIG_PATH=$SPACK_SYSTEM_CONFIG_PATH"
    - pwd

    - export SPACK_JG=$PWD/spack_repo/daint
    - mkdir -p $SPACK_JG/packages
    - cat <<EOF > $SPACK_JG/repo.yaml
    - echo "repo:" > $SPACK_JG/repo.yaml
    - echo "  namespace: jg" >> $SPACK_JG/repo.yaml
    - echo "  api: v2.2" >> $SPACK_JG/repo.yaml
    - spack repo add $SPACK_JG
    - mkdir -p $SPACK_JG/packages/sphexa
    #
    - 'sed -e "s/ci_fake_version/$CI_COMMIT_SHORT_SHA/" -e "s/ci_sha/$CI_COMMIT_SHA/" -e "s!ci_git!$CI_PROJECT_URL.git!" ../ci/scripts/package.py > $SPACK_JG/packages/sphexa/package.py'

    - cp ~/sphexa.git/ci/scripts/package.py $SPACK_JG/spack_repo/jg/packages/sphexa/
    vim $SPACK_JG/spack_repo/jg/packages/sphexa/package.py # comment out mvapich


    - 'uenv-spack --uarch=gh200 --specs="sphexa@$CI_COMMIT_SHORT_SHA +cuda +hdf5 cuda_arch=90 build_type=Debug" --name=sphexa sphexa+spack'
  script:
    - cd sphexa+spack
#    - mkdir -p ./env/repo/packages/sphexa
#    - 'sed -e "s/ci_fake_version/$CI_COMMIT_SHORT_SHA/" -e "s/ci_sha/$CI_COMMIT_SHA/" -e "s!ci_git!$CI_PROJECT_URL.git!" ../ci/scripts/package.py > env/repo/packages/sphexa/package.py'
#    - ln -fs ./env/repo/packages/sphexa/package.py .
#    - 'grep specs: ./env/spack.yaml'
#    - cat env/spack.yaml
    - ./build
    - cd ..
  artifacts:
    paths:
      - sphexa+spack
